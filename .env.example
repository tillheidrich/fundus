# Fundus — example configuration.
#
# Every value below is a default; copy what you need and leave the rest out.
# The defaults are chosen for a server anyone can reach. A desktop install
# sets LOCAL_MODE=1 and gets its own, more permissive set.

# ── Branding (leave empty for a neutral look) ─────────────────────────
APP_NAME=Fundus
BRAND_TAG=
BRAND_TAGLINE=

# Interface language when the browser asks for neither German nor English.
# The browser's own preference always wins; this is only the fallback.
FUNDUS_LANG=en

# ── Access ────────────────────────────────────────────────────────────
# Registration closes automatically once the first account exists.
# Set an invite code to hand out accounts, or OPEN_SIGNUP=1 for a public
# instance (rarely what you want).
SIGNUP_CODE=
OPEN_SIGNUP=0

# Per-user URL limit per hour — keeps one account from monopolising a
# small server.
BATCH_MAX_PER_HOUR=300
BATCH_MAX_URLS=150

# ── Media extraction ──────────────────────────────────────────────────
# The image does not contain an extractor. Transcripts through the
# subtitle endpoint work without one; for everything else either set this
# to 1, or mount your own binary at /usr/local/bin/yt-dlp.
EXTRACTOR_AUTO_INSTALL=0

# Hours between extractor updates. 0 disables them — keeping third-party
# tooling current is a maintenance decision, not something a fresh
# install should start doing by itself.
UPDATE_INTERVAL_H=0

# ── YouTube ───────────────────────────────────────────────────────────
# Allow YouTube media downloads. Off by default: transcripts, captions and
# metadata work regardless, and nothing is preconfigured for this path.
ENABLE_YOUTUBE_VIDEO=0

# Offer the MCP tools get_download_script and get_livestream_script to
# assistants. Off by default: they hand out ready-made media download
# commands, which is a different thing from transcripts and metadata.
# Read at startup; restart after changing it.
ENABLE_MEDIA_TOOLS=0

# yt-dlp player clients, in order. Configurable on purpose — the working
# set changes every few weeks. `android_vr` was the standing recommendation
# for months and has 403'd every one of its formats since 2026-08-17,
# which is exactly why this does not live in the code.
YT_CLIENTS=visionos,web

# Read cookies from a local browser instead of an uploaded file. Local
# installs only — a container has no browser profile.
# BROWSER_COOKIES=safari

# ── Transcription ─────────────────────────────────────────────────────
# Local Whisper for material that has no subtitles at all. The only
# transcript path that does not depend on a platform handing them out.
WHISPER_ENABLED=1

# tiny · base · small · medium · large-v3-turbo
# base is the sweet spot on four cores; it is noticeably weak on German.
# On Apple Silicon (LOCAL_MODE) large-v3-turbo runs on the Neural Engine
# and is affordable.
WHISPER_MODEL=base
WHISPER_MAX_MINUTES=45
# Whisper runs at the same time. Each one holds a model in memory and
# all cores it can get; on a small server keep this at 1.
WHISPER_CONCURRENCY=1
# Largest file accepted by "Transcribe your own file", in MB. The upload
# is deleted as soon as the transcript is done.
UPLOAD_MAX_MB=500

# ── Podcasts ──────────────────────────────────────────────────────────
PODCAST_MAX_EPISODES=25
# Mono speech audio: about 21 MB an hour, fine for listening and for
# Whisper. Episodes past PODCAST_LONG_MINUTES drop to the lower rate.
PODCAST_AUDIO_KBPS=48
PODCAST_LONG_KBPS=32
PODCAST_LONG_MINUTES=90
# Transcribe podcast episodes on this server instead of handing over a
# script. Off by default: an hour of audio keeps a small server busy for
# a long time. Needs WHISPER_ENABLED=1; episodes longer than
# WHISPER_MAX_MINUTES still go to the script.
PODCAST_SERVER_WHISPER=0

# ── Housekeeping ──────────────────────────────────────────────────────
# Delete downloaded files older than this. The server is a transfer
# point, not an archive.
CLEAN_AGE_HOURS=6

# Server-side merge guardrails: beyond these the app hands back a local
# script instead of grinding a small box through a heavy re-encode.
MERGE_MAX_CLIPS=5
MERGE_MAX_SECONDS=900

# Cap for "all parts" playlist/channel grabs.
PLAYLIST_MAX=30

# Longest recording the audio trimmer accepts.
TRIM_MAX_MINUTES=180

# ── Timeouts ──────────────────────────────────────────────────────────
# Ceiling for the fast transcript paths. Local transcription gets its own
# budget on top, because that is real work rather than a stuck request.
TRANSCRIPT_TIMEOUT=75
WHISPER_TIMEOUT=600

# ── Desktop ───────────────────────────────────────────────────────────
# Set by the Mac app. Turns everything on, keeps files for a week, and uses
# the Neural Engine for transcription. A single person on their own
# connection is not the situation the defaults above are cautious about.
#
# It does NOT skip the login any more. That needs FUNDUS_DESKTOP=1, which
# only the Mac app sets when it starts its own server on 127.0.0.1.
# The reason: the loopback exemption reads request.client, and behind a
# reverse proxy on the same host that is 127.0.0.1 for every visitor from
# the internet — so LOCAL_MODE=1 in a public container used to mean no login
# at all, with the first account (the admin) as the implicit user.
# LOCAL_MODE=1

# Comma-separated addresses of proxies in front of this instance. Setting it
# also disables the desktop login exemption: if a proxy is configured, there
# is deliberately something in between, and a loopback peer proves nothing.
# TRUSTED_PROXIES=

# Hours between checks for a newer yt-dlp. Checking only reads a JSON
# document from PyPI and installs nothing; installing stays a button.
# CHECK_INTERVAL_H=24
TZ=Europe/Berlin
